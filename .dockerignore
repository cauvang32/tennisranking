# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Mac
.DS_Store

# Windows
Thumbs.db

# Data files (keep these in the container but not in the image)
data/*.xlsx

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Temporary files
tmp/
temp/

# Local data volumes (managed by Docker volumes in production)
data/postgres/
data/postgres-data/
data/redis-data/
data/tennis.db

# Uploaded media (managed on host, not baked into image)
data/uploads/

# CI/CD and tooling
.github/
.gitlab-ci.yml
.claude/
.gemini/

# Test & docs (not needed in production image)
tests/
docs/
.eslintrc.json
.prettierrc

# Docker files (not needed inside the image)
docker-compose*.yml
Dockerfile
.dockerignore

# Scripts handled by setup.sh and npm scripts

# K3s uses the same immutable image for its migration Job. Individual
# Dockerfiles still decide whether to COPY these files.

# Environment files (secrets)
.env
.env.local
.env.*.local

# Claude Code
.claude/

# Documentation (not needed in production image)
README.md
README_EN.md
CLAUDE.md
MEMORY.md
data/postgres-init/
