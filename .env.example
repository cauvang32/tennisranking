# ── Tennis Ranking System — Environment Configuration ──────────────────────
# Copy to .env and fill in real values.
# Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ───────────────────────────────────────────────────────────────────────────

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  REQUIRED — server will NOT start without these                          ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=tennis_ranking
DB_USER=tennis_user
DB_PASSWORD=your_secure_database_password_here
DB_PORT=5432

# ── Redis (cache + rate-limiting + FCM queue) ─────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth Credentials ───────────────────────────────────────────────────────
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_admin_password_here
EDITOR_USERNAME=your_editor_username
EDITOR_PASSWORD=your_secure_editor_password_here

# ── Security Secrets ───────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
CSRF_SECRET=your_csrf_secret_at_least_32_characters_long

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  OPTIONAL — have sensible defaults, override when needed                 ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── CORS ───────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://yourdomain.com
# Allow localhost dev origins in production (default: false)
ALLOW_DEV_ORIGINS=false

# ── Password Hashing ───────────────────────────────────────────────────────
# 12 rounds = 2^12 = 4096 work factor (OWASP minimum 2^10 = 1024)
# Reduces boot time from ~200ms to ~100ms while maintaining strong security
BCRYPT_ROUNDS=12

# ── JWT Token Expiry ───────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000          # 15 minutes
RATE_LIMIT_MAX_REQUESTS=1000         # general limit per window
RATE_LIMIT_API_MAX=100               # API endpoint limit per window
# Disable rate limiting completely (supports both spellings)
DISABLE_RATE_LIMITING=false
# Dynamic scaling based on CPU/RAM pressure (default: off)
RATE_LIMIT_DYNAMIC_ENABLED=false
RATE_LIMIT_DYNAMIC_SAMPLE_MS=5000
RATE_LIMIT_CPU_HIGH_PCT=80
RATE_LIMIT_CPU_CRITICAL_PCT=95
RATE_LIMIT_RAM_HIGH_PCT=85
RATE_LIMIT_RAM_CRITICAL_PCT=95
RATE_LIMIT_DYNAMIC_SCALE_HIGH=0.7
RATE_LIMIT_DYNAMIC_SCALE_CRITICAL=0.4
RATE_LIMIT_DYNAMIC_MIN_SCALE=0.2

# ── Cache (Redis) ──────────────────────────────────────────────────────────
# Redis TTL is 24h by default. Override with CACHE_TTL_SECONDS (in seconds).
# CACHE_TTL_SECONDS=86400             # 24 hours (default)
CACHE_PRELOAD_INTERVAL=240000         # Refresh cached keys every 4 minutes
# DB_POOL_MAX=10                      # Increase for PM2 cluster mode

# ── Database SSL (for remote DB connections) ────────────────────────────────
# Set DB_SSL=true to enable SSL for the PostgreSQL connection.
# DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false  # Set to 'false' only for local dev
# DB_SSL_CA=/path/to/ca-cert.pem   # Optional: custom CA certificate

# ── Subpath ────────────────────────────────────────────────────────────────
# Set to 'false' to serve the app at the domain root without redirecting
ALLOW_SUBPATH_REDIRECT=true

# ── AI Image Parser (screenshot → match data) ──────────────────────────────
# Uncomment to enable the screenshot upload feature.
# AI_API_KEY=your_openai_compatible_api_key_here
# AI_MODEL=gpt-4o
# AI_BASE_URL=https://api.openai.com/v1

# ── FCM Push Notifications ─────────────────────────────────────────────────
# Uncomment when Firebase is configured.
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/tennis-pro/firebase-service-account.json

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  Security Notes                                                           ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# - All REQUIRED vars above have NO fallback values — server exits if missing
# - Use strong, unique passwords and secrets (32+ characters)
# - Never commit the actual .env file to version control
# - Rotate secrets regularly
# - Use different secrets for dev/staging/prod environments
