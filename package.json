{
  "name": "ranking",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "ws": ">=8.21.0",
    "basic-ftp": ">=6.2.1",
    "ip-address": ">=10.2.0",
    "uuid": "^14.0.0",
    "js-yaml": ">=5.2.2",
    "postcss": ">=8.5.18",
    "brace-expansion": ">=5.0.8"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server.ts",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "server": "node build/server.js",
    "server:source": "tsx server.ts",
    "migrate": "node build/scripts/migrate.js",
    "migrate:source": "tsx scripts/migrate.ts",
    "migrate:k3s": "node build/scripts/migrate-k3s.js",
    "start": "npm run build && npm run server",
    "dev-full": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build:subpath": "BASE_PATH=/tennis/ vite build",
    "build:subdomain": "BASE_PATH=/ vite build",
    "deploy:production": "NODE_ENV=production npm run build && npm run server",
    "preview:subpath": "npm run build:subpath && vite preview",
    "deploy:subpath": "BASE_PATH=/tennis/ NODE_ENV=production npm run build && NODE_ENV=production npm run server",
    "deploy:subdomain": "BASE_PATH=/ NODE_ENV=production npm run build && NODE_ENV=production npm run server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:client && npm run build:server",
    "lint": "eslint .",
    "test:cors": "curl -H \"Origin: https://mydomain.com\" -I http://localhost:3001/api/auth/status",
    "health-check": "curl -I http://localhost:3001/health || echo 'Health check endpoint not available'"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf": "^3.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.3.1",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "pg-cursor": "^2.22.0",
    "pm2": "^7.0.4",
    "rate-limit-redis": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rotating-file-stream": "^3.2.10",
    "ua-parser-js": "^2.0.10",
    "winston": "^3.19.0",
    "write-excel-file": "^4.1.1"
  }
}
